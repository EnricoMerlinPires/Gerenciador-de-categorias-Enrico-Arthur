<head>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  />

  <link rel="stylesheet" href="/CSS/form.css" />
</head>
<%- include("../partials/header") %> <%- include("../partials/nav") %>

<div class="categoria-container">
  <div class="categoria-card">
    <!-- Cabeçalho -->
    <div class="categoria-header">
      <div class="categoria-icon">
        <i class="bi bi-pencil-square"></i>
      </div>

      <div>
        <h2>Editar Categoria</h2>
        <p>Atualize as informações da categoria selecionada</p>
      </div>
    </div>

    <!-- Formulário -->
    <div class="categoria-body">
      <form action="" method="POST">
        <div class="form-group">
          <label for="nome">
            Nome da categoria
            <span class="required">*</span>
          </label>

          <input
            type="text"
            class="categoria-input"
            id="nome"
            name="nome"
            placeholder="Digite o nome da categoria"
            required
            value="<%= categoria.nome %>"
          />

          <small> Altere o nome da categoria conforme necessário. </small>
        </div>

        <div class="form-group">
          <label for="descricao"> Descrição </label>

          <textarea
            class="categoria-input categoria-textarea"
            id="descricao"
            name="descricao"
            rows="4"
            placeholder="Digite a descrição da categoria"
          >
<%= categoria.descricao %></textarea
          >

          <small>
            Atualize a descrição ou mantenha as informações atuais.
          </small>
        </div>

        <!-- Botões -->
        <div class="categoria-actions">
          <a href="/categorias" class="btn-cancelar">
            <i class="bi bi-arrow-left"></i>
            Cancelar
          </a>

          <button type="submit" class="btn-cadastrar">
            <i class="bi bi-check-lg"></i>
            Editar categoria
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
